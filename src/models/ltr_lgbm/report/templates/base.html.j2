<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>
    <link rel   = "icon" type="image/x-icon" href="./assets/favicon.ico">
    <link rel   = "stylesheet" href = "./assets/css/reportbreak.css">
    <link rel   = "stylesheet" href = "./assets/css/charts.css">
    <link rel   = "stylesheet" href = "./assets/css/plotly.css">
    <link rel   = "stylesheet" href = "./assets/css/logo.css">
    <script src = "./assets/js/chart.4.5.1.min.js"></script>
    <script src = "./assets/js/plotly-2.35.2.min.js"></script>
    <script src = "./assets/js/spa.js"></script>
    </head>

<body>

<!-- Sidebar Report Main -->
<nav class="sidebar">
    <div class="sidebar-logo">
    <img src="./assets/compute01.png" alt="LTR">
    </div>

    <div class="sidebar-nav">
    <button class="sidebar-link active"
        onclick="switchPage('overview')"
        data-page="overview">
        <i class="fas fa-th-large"></i>
        <span>Overview</span>
        </button>

    <button class="sidebar-link"
        onclick="switchPage('rankings')"
        data-page="rankings">
        <i class="fas fa-list-ol"></i>
        <span>Rankings</span>
        </button>
    
    <button class="sidebar-link"
        onclick="switchPage('diagnostics')"
        data-page="diagnostics">
        <i class="fas fa-chart-line"></i>
        <span>Diagnostics</span>
        </button>
    
    <button class="sidebar-link"
        onclick="switchPage('config')"
        data-page="config">
        <i class="fas fa-cog"></i>
        <span>Config</span>
        </button>
    </div>

    <div class="sidebar-user">
    <div class="sidebar-avatar">{{ username[0]|upper }}</div>
    <div class="sidebar-user-info">
    <span class="sidebar-user-name">Halo, {{ username|capitalize }}</span>
    <span class="sidebar-user-role">admin</span>
    </div>
    </div>
</nav>


<div class="main">

<div class="page-header">
    <h1>CoopRecSys Explanable AI Dashboard</h1>
    <p>LTR LightGBM Monitoring &mdash; {{ subtitle }}</p>
    </div>

<a 
    class  = "dashboard-logo"
    href   = "https://masterofray.github.io"
    target = "_blank"
    rel    = "noopener noreferrer">
    <img src = "./assets/logo_red.jpg" alt = "Logo">
    </a>


<div class="page-tabs">
    <button class="page-tab active"
        onclick="switchPage('overview')">
        <i class="fas fa-th-large"></i>
        Overview</button>
    
    <button class="page-tab"
        onclick="switchPage('rankings')">
        <i class="fas fa-list-ol"></i>
        Rankings</button>

    <button class="page-tab"
        onclick="switchPage('diagnostics')">
        <i class="fas fa-chart-line"></i>
        Diagnostics</button>

    <button class="page-tab"
        onclick="switchPage('config')">
        <i class="fas fa-cog"></i>
        Config</button>
</div>


{# Halaman 1: Executive KPI Summary #}
{% include "partials/_overview.html.j2" %}

{# Halaman 2: Tabular Rangking and Matriks Retensi #}
{% include "partials/_rankings.html.j2" %}

{# Halaman 3: Charts, Bar Plots, and Plotly Heatmaps #}
{% include "partials/_diagnostics.html.j2" %}

{# Halaman 4: Pipeline Hyperparameters and Environment Config #}
{% include "partials/_config.html.j2" %}

</div>
</body>
</html>