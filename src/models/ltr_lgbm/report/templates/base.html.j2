<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{ page_title }}</title>

<link rel="stylesheet" href="{{ static_css }}/navy_pro.css">
</head>

<body>

<nav class="topbar">
    <div class="topbar-inner">

        <div class="brand">
            <div class="brand-logo">📊</div>
            <span>LTR Monitoring Pro</span>
        </div>

        <div class="nav-links">
            <a href="#overview">Overview</a>
            <a href="#metrics">Metrics</a>
            <a href="#tuning">Tuning</a>
            <a href="#config">Config</a>
            <a href="#charts">Charts</a>
        </div>

        <div class="actions">
            <button class="btn-icon" onclick="toggleTheme()">🌓</button>
            <button class="btn-icon" onclick="jumpTop()">↑</button>
        </div>

    </div>
</nav>

<div class="container">

<header class="hero" id="overview">
    <h1>{{ title }}</h1>
    <p>{{ subtitle }}</p>

    <div class="meta-row">
        <div class="badge">Experiment: {{ experiment_name }}</div>
        <div class="badge">Model: {{ model_path }}</div>
        <div class="badge">Generated: {{ generated_at }}</div>
        <div class="badge">Best Iteration: {{ best_iteration }}</div>
    </div>
</header>

{% block content %}{% endblock %}

<footer>
    Generated by <strong>ltr_framework</strong>
</footer>

</div>

<script src="{{ static_js }}/dashboard.js"></script>
</body>
</html>