{% if tuner_summary %}

<div class="cards mb-16">
    <div class="card">
        <div class="card-label">Trials</div>
        <div class="card-value">{{ tuner_summary.n_trials }}</div>
    </div>

    <div class="card">
        <div class="card-label">Pruned</div>
        <div class="card-value">{{ tuner_summary.n_pruned }}</div>
    </div>

    <div class="card">
        <div class="card-label">Best Score</div>
        <div class="card-value">{{ "%.6f"|format(tuner_summary.best_value) }}</div>
    </div>
</div>

<div class="table-wrap">
<table>
<thead>
<tr>
    <th>Parameter</th>
    <th>Value</th>
</tr>
</thead>

<tbody>
{% for k,v in tuner_summary.best_params.items() %}
<tr>
    <td>{{ k }}</td>
    <td><code>{{ v }}</code></td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

{% else %}
<p class="muted">No tuning summary available.</p>
{% endif %}