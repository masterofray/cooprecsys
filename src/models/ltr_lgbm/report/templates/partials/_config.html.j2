<div id="page-config" class="page-content">

<div class="section">
    <div class="section-title">
        <i class="fas fa-cog"></i>
        Training Configuration</div>
    <div class="table-card">
        <div class="table-header">
        <h3>Model Parameters</h3>
        <span class="table-badge">LightGBM</span>
        </div>

<div class="table-scroll">
    <table class="data-table">
    <thead>
        <tr><th>Parameter</th>
        <th>Value</th></tr>
    </thead>
    <tbody>
    {% for k,v in training_params.items() %}
    <tr>
        <td>{{ k }}</td><td>
        <code>{{ v }}</code></td>
    </tr>
    {% endfor %}
    </tbody>
    </table>
    </div></div>
    </div></div>

<div class="footer">
    Generated by <strong>Masterofray</strong> &mdash; {{ generated_at }}
    </div>

<script src="./assets/js/dashboard.js"></script>