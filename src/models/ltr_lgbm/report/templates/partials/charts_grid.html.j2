<div class="charts">

{% for c in charts %}
<div class="chart {% if c.full %}full{% endif %}">
    <h3>{{ c.title }}</h3>

    {% if c.image %}
        <img src="data:image/png;base64,{{ c.image }}" alt="{{ c.title }}">
    {% else %}
        <p class="muted">Chart unavailable.</p>
    {% endif %}
</div>
{% endfor %}

</div>