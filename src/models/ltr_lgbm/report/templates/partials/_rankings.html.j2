{# =========================================================================
   PARTIAL: _rankings.html.j2
   DESKRIPSI: Komponen tabel performa tabular, ranking fitur, dan rincian metadata
   ========================================================================= #}
<div id="page-rankings" class="page-content">
    <div class="section">
    <div class="section-title">
    <i class="fas fa-list-ol"></i>
    Top {{ rankings|length }} Predictions (LTR LightGBM)
    </div>
    
    <div class="table-card">
        <div class="table-header">
        <h3>Ranking Results</h3>
        <span class="table-badge">rankings_top20.csv</span>
        </div>

        <div class="table-scroll">
        <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>CustomerID</th>
                <th>ProductPrice</th>
                <th>Discount</th>
                <th>CategoryID</th>
                <th>VitalityDays</th>
                <th>EmployeeAge</th>
                <th>YearsWorking</th>
                <th>Relevance</th>
            </tr>
        </thead>
        <tbody>
        {% for r in rankings %}
            <tr>
            <td>
                {% if r.rank <= 3 %}
                <span class="rank-badge rank-{{ r.rank }}">{{ r.rank }}</span>
                {% else %}
                <span class="rank-badge rank-default">{{ r.rank }}</span>
                {% endif %}
            </td>
            <td>{{ r.CustomerID }}</td>
            <td>{{ "%.2f"|format(r.ProductPrice) }}</td>
            <td>{{ "%.1f"|format(r.Discount) }}</td>
            <td>{{ r.CategoryID }}</td>
            <td>{{ "%.0f"|format(r.VitalityDays) }}</td>
            <td>{{ r.EmployeeAge }}</td>
            <td>{{ r.YearsWorking }}</td>
            <td>
                <span class="relevance-bar"
                style="width:{{ (r.relevance_score * 100)|int }}px;">
                </span>
                {{ "%.4f"|format(r.relevance_score) }}
            </td>
            </tr>
        {% endfor %}
        </tbody></table>
        </div>

    </div></div>
</div>