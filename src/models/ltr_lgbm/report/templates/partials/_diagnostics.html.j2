{# =========================================================================
   PARTIAL: _diagnostics.html.j2
   DESKRIPSI: Tempat penampung ChartJS, Plotly Engine, Base64 Images, dan Optuna Tuner
   ========================================================================= #}
<div id="page-diagnostics" class="page-content">

    <div class="section">
        <div class="section-title">
        <i class="fas fa-chart-line"></i>
        <span>Interactive Feature Diagnostics</span>
        </div>
        
        <div class="diagnostic-grid">
        {% for c in charts | default([]) %}

        {# =======================================================
           PLOTLY HEATMAP
        ======================================================== #}
        {% if c['type'] == 'heatmap_plotly' %}
        <div class="diagnostic-panel diagnostic-plotly-panel">
            <h3 class="diagnostic-title">
            {{ c['title'] }}
            </h3>
            <div class="plotly-container">
            <div
                id="plotly-{{ loop.index0 }}"
                class="plotly-chart js-heatmap-render"
                data-title="{{ c['title'] }}"
                data-z="{{ c['data']['z'] | tojson | forceescape }}"
                data-x="{{ c['data']['x'] | tojson | forceescape }}"
                data-y="{{ c['data']['y'] | tojson | forceescape }}">
            </div>
            </div></div>

        {# =======================================================
           CHART.JS BAR CHART
        ======================================================== #}
        {% elif c['type'] == 'bar_chart_js' %}
        <div class="diagnostic-panel diagnostic-chartjs-panel">
            <h3 class="diagnostic-title">
            {{ c['title'] }}
            </h3>
            <div class="chartjs-container">
            <div class="chartjs-wrapper">
                <canvas
                    class="js-bar-chart"
                    id="chartjs-{{ loop.index0 }}"
                    data-labels="{{ c['data']['labels'] | tojson | forceescape }}"
                    data-values="{{ c['data']['values'] | tojson | forceescape }}">
                </canvas>
            </div>
            </div></div>
        
        {# =======================================================
           CHART.JS HISTOGRAM DISTRIBUTION
        ======================================================== #}
        {% elif c['type'] == 'histrelevance' %}
        <link rel="stylesheet" href="./assets/css/histrelevance.css">
        <div class="diagnostic-panel diagnostic-histrelevance-panel">
            <h3 class="diagnostic-title">
            {{ c['title'] }}</h3>
            <div class="histrelevance-container">
            <div class="histrelevance-wrapper">
                <canvas
                    class        = "js-histrelevance-chart"
                    id           = "histrelevance-{{ loop.index0 }}"
                    data-values  = "{{ c['data']['values'] | tojson | forceescape }}"
                    data-bins    = "{{ c['data']['bins'] | tojson | forceescape }}"
                    data-stats   = "{{ c['data']['stats'] | tojson | forceescape }}"
                    data-x-label = "{{ c['data']['axis']['x_label'] }}"
                    data-y-label = "{{ c['data']['axis']['y_label'] }}">
                </canvas>
            <div class="histrelevance-stats">
            <pre>{{ c['data']['stats_text'] }}</pre>
            </div></div></div>
            </div>

        {# =======================================================
           PLOTLY.JS LEARNING CURVE
        ======================================================== #}
        {% elif c['type'] == 'learning_curve' %}
        <link rel="stylesheet" href="./assets/css/learningcurve.css">
        <div class="diagnostic-panel learningcurve-panel">
            <h3 class="diagnostic-title">
            {{ c['title'] }}</h3>
            <div class="learningcurve-container">
                <div
                    id                  = "learningcurve-{{ loop.index0 }}"
                    class               = "plotly-chart js-learningcurve-render"
                    data-lines          = '{{ c["data"]["lines"] | tojson | forceescape }}'
                    data-best-iteration = '{{ c["data"]["best_iteration"] | tojson | forceescape }}'
                    data-axis           = '{{ c["data"]["axis"] | tojson | forceescape }}'
                    data-stats          = '{{ c["data"]["stats"] | tojson | forceescape }}'>
                </div>
            </div></div>

        {# =======================================================
           SHAP WATERFALL CHART
          ======================================================== #}
        {% elif c['type'] == 'shap_waterfall_js' %}
        <link rel="stylesheet" href="./assets/css/shapwaterfall.css">
        <div class="diagnostic-panel diagnostic-shapwaterfall-panel">
            <h3 class="diagnostic-title">
            {{ c['title'] }}</h3>
        <div class="shapwaterfall-container">
            <div
                id               = "shapwaterfall-{{ loop.index0 }}"
                class            = "plotly-chart js-shap-waterfall-render"
                data-title       = "{{ c['title'] | forceescape }}"
                data-sample-idx  = "{{ c['data']['sample_idx'] }}"
                data-base-value  = '{{ c["data"]["base_value"] | tojson | forceescape }}'
                data-prediction  = '{{ c["data"]["prediction"] | tojson | forceescape }}'
                data-max-display = '{{ c["data"]["max_display"] | tojson | forceescape }}'
                data-features    = '{{ c["data"]["features"] | tojson | forceescape }}'>
            </div>
            <div class="shapwaterfall-summary">
                <div class="shap-summary-card">
                    <div class="shap-summary-label">Sample Index</div>
                    <div class="shap-summary-value">
                        {{ c['data']['sample_idx'] }}</div>
                </div>
                <div class="shap-summary-card">
                    <div class="shap-summary-label">Base Value</div>
                    <div class="shap-summary-value">
                        {{ "%.8f"|format(c['data']['base_value']) }}</div>
                </div>
                <div class="shap-summary-card">
                    <div class="shap-summary-label">Prediction</div>
                    <div class="shap-summary-value">
                        {{ "%.8f"|format(c['data']['prediction']) }}</div>
                </div>
                <div class="shap-summary-card">
                    <div class="shap-summary-label">Max Display</div>
                    <div class="shap-summary-value">
                        {{ c['data']['max_display'] }}</div>
                    </div>
                <div class="shap-summary-card">
                    <div class="shap-summary-label">Rendered Features</div>
                    <div class="shap-summary-value">
                        {{ c['data']['features'] | length }}</div>
                </div></div>

        {# --------------- FEATURE TABLE --------------- #}
        <div class="shapwaterfall-feature-table-wrapper">
        <table class="shapwaterfall-feature-table">
            <thead>
            <tr>
                <th>Feature</th>
                <th>Value</th>
                <th>SHAP</th>
                <th>|SHAP|</th>
            </tr>
            </thead>
            
            <tbody>
            {% for feat in c['data']['features'] %}
            <tr>
                <td class="shap-feature-name">{{ feat['feature'] }}</td>
                <td class="shap-feature-value">{{ feat['feature_value'] }}</td>
                <td class="shap-feature-shap
                    {% if feat['shap_value'] >= 0 %}
                        shap-positive
                    {% else %}
                        shap-negative
                    {% endif %}">
                    {{ "%.8f"|format(feat['shap_value']) }}
                </td>
                <td class="shap-feature-abs">
                {{ "%.8f"|format(feat['abs_shap']) }}</td>
            </tr>
            {% endfor %}
            </tbody>
            </table>
            </div>
            </div>
        </div>

        {% endif %}
    {% endfor %}

    </div></div>



    {% if tuner_summary %}
    <div class="section" style="margin-top: 40px;">
        <div class="section-title">
        <i class="fas fa-flask"></i>
        <span>Bayesian Tuning Hyperparameter Optimization</span>
        </div>

        <div class="cards-row">
            <div class="scorecard blue">
            <div class="scorecard-body">
            <div class="scorecard-label">Total Trials Executed</div>
            <div class="scorecard-value">{{ tuner_summary.n_trials }}</div>
            </div></div>
            
            <div class="scorecard orange">
            <div class="scorecard-body">
            <div class="scorecard-label">Trials Pruned (Early Stopping)</div>
            <div class="scorecard-value">{{ tuner_summary.n_pruned }}</div>
            </div></div>
            
            <div class="scorecard green">
            <div class="scorecard-body">
            <div class="scorecard-label">Best Objective Score</div>
            <div class="scorecard-value">{{ "%.6f"|format(tuner_summary.best_value) }}</div>
            </div></div>
        </div>


        <link rel="stylesheet" href="./assets/css/paramscard.css">
        <div class="table-card" style="margin-top:16px;">
            <div class="table-header">
            <h3 style="font-size: 1.1rem;">Optimal Parameter Combination</h3>
            </div>
            <div class="score-card-container" style="padding: 16px;">
            {% for k, v in tuner_summary.best_params.items() %}
            <div class="score-card" data-parameter="{{ k }}" data-value="{{ v }}">
            <div class="score-value">
                {% if v is float %}
                    {{ "%.8f"|format(v) }}
                {% else %}
                    {{ v }}
                {% endif %}
            </div>
            <div class="score-label">
            {{ k|replace('_', ' ')|title }}
            </div></div>
            {% endfor %}
        </div></div></div>
    {% endif %}

</div>
<script type="module">
    import { initHeatmaps } from "./assets/js/heatmaps.js";
    import { initBarCharts } from "./assets/js/fbarplot.js";
    import { initHistRelevance } from "./assets/js/histrelevance.js";
    import { initLearningCurves } from "./assets/js/learningcurve.js";
    import { initLearningCurves } from "./assets/js/shapwaterfall.js";
    import { initParamsCards } from "./assets/js/paramscard.js";

    document.addEventListener("DOMContentLoaded", () => {
        const diagnosticsContainer = document.getElementById("page-diagnostics");
        if (!diagnosticsContainer) {
            console.warn("[Diagnostics] Container tidak ditemukan.");
            return;}
        console.log("[Diagnostics] Initializing scoped modules.");
        initHeatmaps(diagnosticsContainer);
        initBarCharts(diagnosticsContainer);
        initHistRelevance(diagnosticsContainer);
        initParamsCards(diagnosticsContainer);
        initLearningCurves(diagnosticsContainer);
        initShapWaterfalls(diagnosticsContainer);
    });
</script>
