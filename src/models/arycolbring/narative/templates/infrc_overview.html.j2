{# overview.html.j2 — Inference Overview: scorecards, charts, gauges #}

<div id="page-overview" class="page-content active">

    <!-- Scorecard Section -->
    <div class="section">
        <div class="section-title">
            <span class="section-icon"><i class="fas fa-bolt"></i></span>
            Scorecard
        </div>

        <div class="cards-row">
            {% for card in scorecards %}
            <div class="scorecard" data-color="{{ card.color }}" data-parameter="{{ card.label }}" data-value="{{ card.value }}">
                <div class="scorecard-icon"><i class="{{ card.icon_class | default('fas fa-chart-line') }}"></i></div>
                <div class="scorecard-body">
                    <div class="scorecard-label">{{ card.label }}</div>
                    <div class="scorecard-value">{{ card.value }}</div>
                    <div class="scorecard-sub">{{ card.sub }}</div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Control: Chart + Stat Minis -->
    <div class="section">
        <div class="section-title">
            <span class="section-icon"><i class="fas fa-sliders"></i></span>
            Control
        </div>

        <div class="control-grid">
            <div class="chart-panel">
                <div class="chart-panel-title">Inference Analytics</div>
                <div class="chart-panel-value">{{ scorecards | length }} Metrics Tracked</div>
                <div class="chart-container">
                    <canvas id="inferenceLineChart" class="js-line-chart"
                            data-labels='{{ bar_labels | tojson }}'
                            data-values='{{ bar_data | tojson }}'></canvas>
                </div>
            </div>

            <div class="stat-mini-col">
                {% set stat_icons = ['fas fa-bullseye','fas fa-users','fas fa-clock','fas fa-shield-halved'] %}
                {% set stat_colors = ['#1565c0','#2e7d32','#e65100','#6a1b9a'] %}
                {% for stat in stat_minis %}
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:{{ stat_colors[loop.index0 % 4] }}18;color:{{ stat_colors[loop.index0 % 4] }};">
                        <i class="{{ stat_icons[loop.index0 % 4] }}"></i>
                    </div>
                    <div class="stat-mini-info">
                        <div class="stat-mini-label">{{ stat.label }}</div>
                        <div class="stat-mini-value">{{ stat.value }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- All Metrics Chart -->
    <div class="section">
        <div class="section-title">
            <span class="section-icon"><i class="fas fa-chart-line"></i></span>
            All Metrics Overview
        </div>

        <div class="chart-panel">
            <div class="chart-container" style="height:360px;">
                <canvas id="allMetricsChart" class="js-line-chart"
                        data-labels='{{ bar_labels | tojson }}'
                        data-values='{{ bar_data | tojson }}'></canvas>
            </div>
        </div>
    </div>

    <!-- Gauges -->
    {% if gauges %}
    <div class="section">
        <div class="section-title">
            <span class="section-icon"><i class="fas fa-bullseye"></i></span>
            Gauge
        </div>

        <div class="gauge-grid">
            {% for gauge in gauges %}
            <div class="gauge-card">
                <div class="gauge-chart">
                    <canvas id="gauge_{{ loop.index0 }}" class="js-gauge-chart"
                            data-percent="{{ gauge.percent }}"
                            data-color-index="{{ loop.index0 }}"></canvas>
                    <div class="gauge-center-value">{{ gauge.display }}</div>
                </div>
                <div class="gauge-label">{{ gauge.label }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Inference Config + Overall Score -->
    <div class="section">
        <div class="section-title">
            <span class="section-icon"><i class="fas fa-gear"></i></span>
            Inference Configuration
        </div>

        <div class="control-grid">
            <div class="chart-panel">
                <table class="config-table">
                    <tr><td>Model Version</td><td>v{{ model_version }}</td></tr>
                    <tr><td>Batch Size</td><td>{{ batch_size }}</td></tr>
                    <tr><td>Num Threads</td><td>{{ num_threads }}</td></tr>
                    <tr><td>Cache Enabled</td><td>{{ inference_params.get('cache_enabled', 'N/A') }}</td></tr>
                </table>
            </div>
            <div class="overall-score-card">
                <div class="overall-score-value">{{ overall_score }}</div>
                <div class="overall-score-label">Overall Score</div>
                <div style="margin-top:8px;font-size:0.8rem;color:var(--text-muted);">Predictions: {{ total_rankings }}</div>
            </div>
        </div>
    </div>

</div>
