<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Vendor (local) -->
    <link rel="stylesheet" href="{{ static_css }}/fontawesome_6.5.1_all.css">
    <script src="{{ static_js }}/chart.4.5.1.min.js"></script>
    <script src="{{ static_js }}/plotly-2.35.2.min.js"></script>

    <!-- CSS -->
    <link rel="stylesheet" href="{{ static_css }}/base.css">
    <link rel="stylesheet" href="{{ static_css }}/animations.css">
    <link rel="stylesheet" href="{{ static_css }}/overview.css">
    <link rel="stylesheet" href="{{ static_css }}/rankings.css">
    <link rel="stylesheet" href="{{ static_css }}/diagnostics.css">
    <link rel="stylesheet" href="{{ static_css }}/config.css">
    <link rel="stylesheet" href="{{ static_css }}/insights.css">
</head>
<body>

<div class="app-wrapper">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo" title="Dashboard">
            {% set logo_text = page_title.split(' ')[0] if page_title else 'D' %}
            {{ logo_text[:3] | upper }}
        </div>
        <nav class="sidebar-nav">
            <button class="sidebar-link active" data-page="overview">
                <span class="sidebar-icon"><i class="fas fa-chart-bar"></i></span>
                <span>Overview</span>
            </button>
            <button class="sidebar-link" data-page="rankings">
                <span class="sidebar-icon"><i class="fas fa-trophy"></i></span>
                <span>Rankings</span>
            </button>
            <button class="sidebar-link" data-page="insights">
                <span class="sidebar-icon"><i class="fas fa-diagram-project"></i></span>
                <span>Insights</span>
            </button>
            <button class="sidebar-link" data-page="diagnostics">
                <span class="sidebar-icon"><i class="fas fa-microscope"></i></span>
                <span>Diagnostics</span>
            </button>
            <button class="sidebar-link" data-page="config">
                <span class="sidebar-icon"><i class="fas fa-gear"></i></span>
                <span>Config</span>
            </button>
        </nav>
        <div class="sidebar-user">
            <div class="sidebar-avatar"><i class="fas fa-rocket"></i></div>
            <div style="overflow:hidden;">
                <div style="font-size:0.82rem;font-weight:600;color:var(--text-on-dark);white-space:nowrap;">Inference</div>
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.45);white-space:nowrap;">v{{ model_version }}</div>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <main class="main">

        <header class="page-header">
            <div>
                <h1>{{ page_title }}</h1>
                <p>{{ subtitle }} — Model v{{ model_version }} | {{ experiment_name }}</p>
            </div>
            <div class="header-right">
                <div>
                    <small>Generated: {{ generated_at }}</small><br>
                    <small>Batch: {{ batch_size }} | Threads: {{ num_threads }}</small>
                </div>
            </div>
        </header>

        <nav class="page-tabs">
            <button class="page-tab active" data-tab="overview"><i class="fas fa-chart-bar"></i> Overview</button>
            <button class="page-tab" data-tab="rankings"><i class="fas fa-trophy"></i> Rankings</button>
            <button class="page-tab" data-tab="insights"><i class="fas fa-diagram-project"></i> Insights</button>
            <button class="page-tab" data-tab="diagnostics"><i class="fas fa-microscope"></i> Diagnostics</button>
            <button class="page-tab" data-tab="config"><i class="fas fa-gear"></i> Config</button>
        </nav>

        {% include 'infrc_overview.html.j2' %}
        {% include 'infrc_rankings.html.j2' %}
        {% include 'infrc_insights.html.j2' %}
        {% include 'infrc_diagnostics.html.j2' %}
        {% include 'infrc_config.html.j2' %}

        <footer class="footer">
            <p>&copy; 2026 <strong>AryColBring</strong> — Production Inference System</p>
            <p><small>Real-time Collaborative Filtering with Cython Optimization | Generated {{ generated_at }}</small></p>
        </footer>

    </main>
</div>

<!-- JS -->
<script src="{{ static_js }}/spa.js"></script>
<script src="{{ static_js }}/overview.js"></script>
<script src="{{ static_js }}/rankings.js"></script>
<script src="{{ static_js }}/insights.js"></script>
<script src="{{ static_js }}/diagnostics.js"></script>
<script src="{{ static_js }}/config.js"></script>
<script src="{{ static_js }}/dashboard.js"></script>

</body>
</html>
