<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title }}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- FontAwesome 6.5.1 (local) -->
    <link rel="stylesheet" href="{{ static_vendor }}/fontawesome_6.5.1_all.css">

    <!-- Chart.js 4.5.1 (local) -->
    <script src="{{ static_vendor }}/chart.4.5.1.min.js"></script>

    <!-- Plotly 2.35.2 (local) -->
    <script src="{{ static_vendor }}/plotly-2.35.2.min.js"></script>

    <!-- CSS (split per module) -->
    <link rel="stylesheet" href="{{ static_css }}/base.css">
    <link rel="stylesheet" href="{{ static_css }}/animations.css">
    <link rel="stylesheet" href="{{ static_css }}/overview.css">
    <link rel="stylesheet" href="{{ static_css }}/rankings.css">
    <link rel="stylesheet" href="{{ static_css }}/diagnostics.css">
    <link rel="stylesheet" href="{{ static_css }}/config.css">
</head>
<body>

<div class="app-wrapper">

    <!-- ============================================================
         Sidebar
         ============================================================ -->
    <aside class="sidebar">
        <div class="sidebar-logo" title="Dashboard">
            {% set logo_text = page_title.split(' ')[0] if page_title else 'D' %}
            {{ logo_text[:3] | upper }}
        </div>
        <nav class="sidebar-nav">
            <button class="sidebar-link active" data-page="overview">
                <span class="sidebar-icon"><i class="fas fa-chart-bar"></i></span>
                <span>Overview</span>
            </button>
            <button class="sidebar-link" data-page="rankings">
                <span class="sidebar-icon"><i class="fas fa-trophy"></i></span>
                <span>Rankings</span>
            </button>
            <button class="sidebar-link" data-page="diagnostics">
                <span class="sidebar-icon"><i class="fas fa-microscope"></i></span>
                <span>Diagnostics</span>
            </button>
            <button class="sidebar-link" data-page="config">
                <span class="sidebar-icon"><i class="fas fa-gear"></i></span>
                <span>Config</span>
            </button>
        </nav>
        <div class="sidebar-user">
            <div class="sidebar-avatar"><i class="fas fa-user"></i></div>
            <div style="overflow:hidden;">
                <div style="font-size:0.82rem;font-weight:600;color:var(--text-on-dark);white-space:nowrap;">Dashboard</div>
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.45);white-space:nowrap;">{{ model_type }}</div>
            </div>
        </div>
    </aside>

    <!-- ============================================================
         Main Content
         ============================================================ -->
    <main class="main">

        <!-- Page Header -->
        <header class="page-header">
            <div>
                <h1>{{ page_title }}</h1>
                <p>{{ subtitle }} — {{ model_type }} Model Evaluation &amp; Diagnostics</p>
            </div>
            <div class="header-right">
                <div>
                    <small>Generated: {{ generated_at }}</small><br>
                    <small>Loss: {{ loss_function }} | Epochs: {{ epochs }}</small>
                </div>
            </div>
        </header>

        <!-- Tab Navigation -->
        <nav class="page-tabs">
            <button class="page-tab active" data-tab="overview"><i class="fas fa-chart-bar"></i> Overview</button>
            <button class="page-tab" data-tab="rankings"><i class="fas fa-trophy"></i> Rankings</button>
            <button class="page-tab" data-tab="diagnostics"><i class="fas fa-microscope"></i> Diagnostics</button>
            <button class="page-tab" data-tab="config"><i class="fas fa-gear"></i> Config</button>
        </nav>

        <!-- Page Partials -->
        {% include 'train_overview.html.j2' %}
        {% include 'train_rankings.html.j2' %}
        {% include 'train_diagnostics.html.j2' %}
        {% include 'train_config.html.j2' %}

        <!-- Footer -->
        <footer class="footer">
            <p>&copy; 2026 <strong>AryColBring</strong> — Collaborative Filtering Model</p>
            <p><small>Powered by Cython-optimized Matrix Factorization | Generated {{ generated_at }}</small></p>
        </footer>

    </main>
</div>

<!-- JS (split per module) -->
<script src="{{ static_js }}/spa.js"></script>
<script src="{{ static_js }}/overview.js"></script>
<script src="{{ static_js }}/rankings.js"></script>
<script src="{{ static_js }}/diagnostics.js"></script>
<script src="{{ static_js }}/config.js"></script>
<script src="{{ static_js }}/dashboard.js"></script>

</body>
</html>
