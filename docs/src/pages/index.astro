---
import Layout from '../layouts/Layout.astro';
import { getAllDocs, getDocsByCategory, getDocUrl, getCategoryUrl } from '../lib/docs';
import { SITE_CONFIG } from '../lib/site-config';

const docs = await getAllDocs();
const byCategory = await getDocsByCategory();
const categories = Object.entries(byCategory);
const featured = docs.slice(0, 6);
const heroImage = 'https://ik.imagekit.io/arydatalabs/cooprecsys/cooprecsys_banner.jpg';
---
<Layout title="CoopRecSys Documentation" description="Advanced documentation for the CoopRecSys Python machine learning and AI recommendation system.">
  <section class="bg-white border-b border-brand-gray-200">
    <div class="container-wide py-14 lg:py-20">
      <div class="rounded-[28px] overflow-hidden relative min-h-[360px] lg:min-h-[470px] flex items-end bg-brand-gray-900">
        <img src={heroImage} alt="CoopRecSys banner" class="absolute inset-0 w-full h-full object-cover opacity-70" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="relative z-10 max-w-4xl p-8 lg:p-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 text-white text-xs font-semibold backdrop-blur">CoopRecSys v0.0.3 · Production-oriented ML package</div>
          <h1 class="text-white text-4xl lg:text-6xl font-bold tracking-tight mt-5">CoopRecSys Documentation</h1>
          <p class="text-white/85 text-base lg:text-xl leading-relaxed mt-5 max-w-3xl">A production-grade recommendation-system toolkit combining collaborative filtering, learning-to-rank, two-tower modeling, explainability, data preparation, and operational diagnostics for cooperative product recommendations.</p>
          <div class="flex flex-wrap gap-3 mt-7">
            <a href={`${SITE_CONFIG.links.docsHome}/getting-started/installation`} class="px-5 py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary-dark">Get Started</a>
            <a href={SITE_CONFIG.links.pypi} target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-full bg-white text-brand-gray-900 font-semibold hover:bg-brand-gray-100">View on PyPI</a>
            <a href={SITE_CONFIG.links.github} target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-full bg-white/10 text-white border border-white/30 font-semibold hover:bg-white/20">Source on GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-18 bg-brand-gray-50">
    <div class="container-wide grid lg:grid-cols-[1.1fr_0.9fr] gap-8">
      <div class="bg-white rounded-[22px] border border-brand-gray-200 p-7 lg:p-9">
        <p class="text-sm font-semibold text-primary uppercase tracking-[0.12em]">System Scope</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">From transaction data to explainable recommendations</h2>
        <p class="mt-4 text-brand-gray-600 leading-7">The package includes data preparation, feature engineering, DuckDB-backed ingestion, three recommendation families, evaluation utilities, narrative reporting, and dashboard-oriented visualization components.</p>
        <div class="grid sm:grid-cols-2 gap-4 mt-7">
          {['AryColBring collaborative filtering','Ary2Tower two-tower neural recommender','LTR-LightGBM learning-to-rank','Explainability & diagnostics dashboards'].map((item)=><div class="rounded-xl bg-brand-gray-50 border border-brand-gray-200 px-4 py-4 font-semibold text-sm">{item}</div>)}
        </div>
      </div>
      <div class="bg-white rounded-[22px] border border-brand-gray-200 p-7 lg:p-9">
        <p class="text-sm font-semibold text-primary uppercase tracking-[0.12em]">Current Release</p>
        <div class="text-5xl font-bold mt-3">0.0.3</div>
        <p class="mt-3 text-brand-gray-600">Release hardening focused on native extension compatibility, manylinux wheels, CI/CD reliability, and PyPI metadata compliance.</p>
        <ul class="mt-6 space-y-3 text-sm text-brand-gray-700 list-disc pl-5"><li>Python 3.10–3.13 release matrix</li><li>Linux manylinux-compatible wheels</li><li>Native Cython/OpenMP components</li><li>GitHub Actions build and publishing pipeline</li></ul>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-18 bg-white">
    <div class="container-wide">
      <div class="flex items-end justify-between gap-6 mb-8"><div><p class="text-sm font-semibold text-primary uppercase tracking-[0.12em]">Documentation Map</p><h2 class="text-3xl font-bold mt-2">Explore the system</h2></div><a href={SITE_CONFIG.links.docsHome} class="text-primary font-semibold">All documentation →</a></div>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
        {categories.map(([category, items])=><a href={getCategoryUrl(category)} class="group rounded-[20px] border border-brand-gray-200 p-6 hover:border-primary/40 hover:shadow-[var(--sgkb-shadow-md)] transition-all bg-white"><div class="flex items-center justify-between"><h3 class="text-xl font-semibold">{category}</h3><span class="text-xs px-2.5 py-1 rounded-full bg-brand-gray-100 text-brand-gray-600">{items.length} docs</span></div><p class="mt-3 text-sm leading-6 text-brand-gray-500">{items[0]?.data.description || `Technical documentation for ${category}.`}</p><span class="inline-block mt-5 text-sm font-semibold text-primary group-hover:translate-x-1 transition-transform">Open section →</span></a>)}
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-18 bg-brand-gray-50">
    <div class="container-wide">
      <div class="mb-8"><p class="text-sm font-semibold text-primary uppercase tracking-[0.12em]">Selected Guides</p><h2 class="text-3xl font-bold mt-2">Start with the core workflows</h2></div>
      <div class="grid lg:grid-cols-2 gap-5">{featured.map((doc)=><a href={getDocUrl(doc)} class="rounded-[18px] bg-white border border-brand-gray-200 p-6 hover:border-primary/40 hover:-translate-y-0.5 transition-all"><div class="text-xs font-semibold text-primary uppercase">{doc.data.category}</div><h3 class="text-xl font-semibold mt-2">{doc.data.title}</h3><p class="text-sm text-brand-gray-500 leading-6 mt-2">{doc.data.description}</p></a>)}</div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container-wide">
      <div class="rounded-[24px] border border-brand-gray-200 bg-brand-gray-50 p-8 lg:p-10 flex flex-col lg:flex-row gap-8 items-center">
        <img src="https://ik.imagekit.io/arydatalabs/cooprecsys/Cooprecsys.png" alt="CoopRecSys" class="w-28 h-28 rounded-2xl object-cover border border-brand-gray-200 bg-white" loading="lazy" />
        <div class="flex-1"><p class="text-sm font-semibold text-primary uppercase tracking-[0.12em]">Maintained by Aryanto</p><h2 class="text-2xl font-bold mt-2">Engineering, research, and applied ML documentation</h2><p class="mt-3 text-brand-gray-600 leading-7">Portfolio: <a class="text-primary font-semibold" href={SITE_CONFIG.links.portfolio} target="_blank" rel="noopener noreferrer">ai.arydatalabs.workers.dev</a> · LinkedIn: <a class="text-primary font-semibold" href={SITE_CONFIG.links.linkedin} target="_blank" rel="noopener noreferrer">aryanto-ray</a> · Email: <a class="text-primary font-semibold" href={SITE_CONFIG.links.email}>aryanto.dandan@gmail.com</a></p></div>
      </div>
    </div>
  </section>
</Layout>
